# Copy this file to .env and fill in real values before starting the server.
# Never commit the real .env file to version control.

# Long, random string used to sign session (JWT) tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the server listens on.
PORT=3000

# "production" enables secure (HTTPS-only) cookies. Keep as "development" on localhost.
NODE_ENV=development

# Restrict cross-origin requests in production if the frontend is served
# from a different domain than the API. Leave unset for same-origin setups.
# CORS_ORIGIN=https://your-domain.com
